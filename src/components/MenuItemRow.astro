---
import { formatPrice, type MenuItem } from '../data/restaurant';

interface Props {
  item: MenuItem;
}

const { item } = Astro.props;
const badge = 'h-5 items-center bg-seal-500 px-1.5 text-[0.68rem] font-medium tracking-[0.14em] text-hanji-50';
---

<li class="menu-row py-[1.1rem] first:pt-0 lg:py-[1.3rem]">
  {item.signature && <span class:list={[badge, 'mb-2.5 flex w-fit sm:hidden']}>대표</span>}
  <div class="flex items-baseline">
    <span class="flex flex-wrap items-baseline gap-x-2.5 gap-y-1">
      <span class="font-display text-[1.2rem] font-medium tracking-[0.02em] lg:text-[1.3rem]">{item.name}</span>{' '}
      {item.signature && <span class:list={[badge, 'relative -top-0.5 hidden sm:inline-flex']}>대표</span>}{' '}
      {item.hanwoo && <span class="text-[0.75rem] tracking-[0.12em] text-gold-700">한우</span>}{' '}
      {
        item.tag && (
          <span class="relative -top-0.5 inline-flex h-5 items-center border border-ink-900/20 px-1.5 text-[0.68rem] tracking-[0.1em] text-ink-500">
            {item.tag}
          </span>
        )
      }
    </span>
    <span class="leader text-ink-900" aria-hidden="true"></span>{' '}
    <span class="flex shrink-0 items-baseline gap-3">
      {item.weight && <span class="tabular text-[0.85rem] text-ink-500">{item.weight}</span>}{' '}
      <span class="tabular font-display text-[1.2rem] font-medium lg:text-[1.3rem]">
        {formatPrice(item.price)}<span class="ml-0.5 font-sans text-[0.8rem] font-normal text-ink-500">원</span>
      </span>
    </span>
  </div>
  {item.detail && <p class="mt-1.5 text-[0.85rem] leading-relaxed text-ink-500">{item.detail}</p>}
  {item.note && <p class="mt-1 text-[0.8rem] leading-relaxed text-ink-500">{item.signature ? `* ${item.note}` : item.note}</p>}
</li>
