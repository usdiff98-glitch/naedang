---
import grillPhoto from '../assets/photos/saeusal-grill.jpg';
import { quotes, tableExtraWhenAvailable, tableExtras } from '../data/restaurant';
import Photo from './Photo.astro';
import SectionLabel from './SectionLabel.astro';

// Positions on a top-down table, as percentages of the illustration box.
const layout: Record<string, { x: number; y: number; d: number; shape?: 'oval' | 'pot' }> = {
  육회: { x: 20, y: 19, d: 23 },
  생간: { x: 50, y: 10, d: 17 },
  허파전: { x: 80, y: 21, d: 25, shape: 'oval' },
  더덕구이: { x: 82, y: 76, d: 24, shape: 'oval' },
  알밥: { x: 50, y: 89, d: 18, shape: 'pot' },
};
const extra = { x: 18, y: 76, d: 26 };
---

<section id="table" class="surface-ink section-y relative isolate overflow-hidden" aria-labelledby="table-title">
  <div class="container-site grid gap-y-16 lg:grid-cols-12 lg:items-center lg:gap-x-14">
    <div class="lg:col-span-5">
      <SectionLabel id="table" tone="ink" />
      <h2 id="table-title" class="mt-8 font-display text-[clamp(2.1rem,6.2vw,3.2rem)] font-normal leading-[1.3] tracking-[-0.02em] text-hanji-50 lg:text-[clamp(2.2rem,3vw,3.2rem)]" data-reveal="ink">
        고기를 시키시면<br />곁들이는 음식이 같이 나옵니다.
      </h2>

      <figure class="mt-10 border-l border-gold-500/50 pl-6" data-reveal style="--delay:120ms">
        <blockquote class="font-display text-[1.08rem] leading-[1.95] text-hanji-200 lg:text-[1.15rem]">
          “{quotes.extras}”
        </blockquote>
        <figcaption class="mt-4 text-[0.8rem] tracking-[0.14em] text-hanji-400">사장님 소개글 (네이버 플레이스)</figcaption>
      </figure>

      <div class="mt-12 flex items-center gap-5" data-reveal style="--delay:200ms">
        <Photo
          src={grillPhoto}
          alt="불판 위에서 구워지고 있는 한우 새우살 두 점."
          sizes="7rem"
          class="aspect-square w-24 shrink-0 rounded-full sm:w-28"
          reveal={false}
        />
        <p class="text-[0.95rem] leading-[1.85] text-hanji-300">
          처음에는 직원이 고기를 직접 구워 드리고,<br class="hidden sm:inline" /> 무슨 부위인지도 알려 드립니다.
        </p>
      </div>
    </div>

    <div class="lg:col-span-7">
      <div class="table-art relative mx-auto aspect-square w-full max-w-[36rem]" data-reveal>
        <div aria-hidden="true" class="table-top absolute inset-[4%] rounded-[2.2rem]"></div>

        <div aria-hidden="true" class="grill absolute left-1/2 top-1/2 aspect-square w-[38%] -translate-x-1/2 -translate-y-1/2 rounded-full">
          <svg viewBox="0 0 100 100" class="absolute inset-0 h-full w-full">
            <circle cx="50" cy="50" r="49" class="fill-none stroke-gold-400/50" stroke-width="0.6"></circle>
            <circle cx="50" cy="50" r="44" class="fill-none stroke-gold-400/30" stroke-width="0.5"></circle>
            {
              Array.from({ length: 24 }, (_, i) => {
                const a = (i / 24) * Math.PI * 2;
                const r1 = 34;
                const r2 = 39;
                return (
                  <line
                    x1={50 + Math.cos(a) * r1}
                    y1={50 + Math.sin(a) * r1}
                    x2={50 + Math.cos(a) * r2}
                    y2={50 + Math.sin(a) * r2}
                    class="stroke-gold-400/40"
                    stroke-width="1.4"
                    stroke-linecap="round"
                  />
                );
              })
            }
            <circle cx="50" cy="50" r="27" class="fill-none stroke-gold-400/20" stroke-width="0.5"></circle>
          </svg>
          <span class="absolute inset-0 grid place-items-center text-center">
            <span class="font-display text-[length:var(--fs-grill)] tracking-[0.3em] text-gold-300/90">불판</span>
          </span>
        </div>

        <ul aria-label="고기 주문 시 함께 나오는 구성" class="absolute inset-0">
          {
            tableExtras.map((name, i) => {
              const p = layout[name];
              return (
                <li
                  class:list={['dish absolute grid place-items-center text-center', p.shape && `dish-${p.shape}`]}
                  style={`left:${p.x}%;top:${p.y}%;width:${p.d * (p.shape === 'oval' ? 1.22 : 1)}%;--i:${i}`}
                >
                  <span class="font-display text-[length:var(--fs-dish)] leading-tight text-hanji-50">{name}</span>
                </li>
              );
            })
          }
          <li class="dish dish-extra absolute grid place-items-center text-center" style={`left:${extra.x}%;top:${extra.y}%;width:${extra.d}%;--i:5`}>
            <span class="px-2 font-display text-[length:var(--fs-dish)] leading-snug text-gold-200">
              꼬리살<br />육사시미
              <span class="mt-1 block font-sans text-[length:var(--fs-note)] tracking-[0.06em] text-hanji-400">물량이 있을 때</span>
            </span>
          </li>
        </ul>
      </div>
      <p class="mt-6 text-center text-[0.8rem] leading-relaxed text-hanji-400">
        {tableExtras.join(', ')} 같은 음식이 같이 나오고, {tableExtraWhenAvailable}는 고기가 있는 날 나갑니다.<br />
        그날 사정에 따라 조금씩 달라질 수 있습니다.
      </p>
    </div>
  </div>
</section>

<style>
  .table-art {
    container-type: inline-size;
    --fs-dish: clamp(0.72rem, 3.6cqw, 1.2rem);
    --fs-note: clamp(0.6rem, 2.2cqw, 0.72rem);
    --fs-grill: clamp(0.7rem, 3cqw, 0.95rem);
  }

  .table-top {
    background:
      repeating-linear-gradient(
        180deg,
        color-mix(in oklab, var(--color-hanji-100) 2.5%, transparent) 0 1px,
        transparent 1px 9px,
        color-mix(in oklab, var(--color-ink-950) 22%, transparent) 9px 12px,
        transparent 12px 23px
      ),
      linear-gradient(160deg, var(--color-ink-800), var(--color-ink-850) 55%, var(--color-ink-900));
    box-shadow:
      inset 0 0 0 1px color-mix(in oklab, var(--color-gold-400) 16%, transparent),
      0 40px 80px -30px rgb(0 0 0 / 0.6);
  }

  .grill {
    background: radial-gradient(circle, var(--color-ink-700) 0%, var(--color-ink-900) 70%);
    box-shadow:
      0 0 0 6px color-mix(in oklab, var(--color-ink-950) 70%, transparent),
      0 0 60px -10px color-mix(in oklab, var(--color-gold-400) 22%, transparent);
  }

  .dish {
    aspect-ratio: 1;
    translate: -50% -50%;
    border-radius: 999px;
    background: radial-gradient(circle at 38% 32%, var(--color-ink-600), var(--color-ink-800) 62%);
    box-shadow:
      inset 0 0 0 1px color-mix(in oklab, var(--color-gold-300) 45%, transparent),
      inset 0 0 0 5px var(--color-ink-800),
      inset 0 0 0 6px color-mix(in oklab, var(--color-gold-300) 18%, transparent),
      0 14px 24px -12px rgb(0 0 0 / 0.7);
  }

  .dish-oval {
    aspect-ratio: 1.45;
    border-radius: 50%;
  }

  .dish-pot {
    background: radial-gradient(circle at 40% 35%, var(--color-ink-700), var(--color-ink-950) 70%);
    box-shadow:
      inset 0 0 0 1px color-mix(in oklab, var(--color-gold-300) 40%, transparent),
      inset 0 0 0 7px var(--color-ink-900),
      inset 0 0 0 8px color-mix(in oklab, var(--color-gold-300) 20%, transparent),
      0 14px 24px -12px rgb(0 0 0 / 0.7);
  }

  .dish-extra {
    background: transparent;
    box-shadow: none;
    border: 1px dashed color-mix(in oklab, var(--color-gold-300) 55%, transparent);
  }

  :global(.js) .table-art .dish {
    opacity: 0;
    scale: 0.86;
    transition:
      opacity 0.9s var(--ease-silk),
      scale 0.9s var(--ease-silk);
    transition-delay: calc(0.35s + var(--i) * 0.12s);
  }

  :global(.js) .table-art.is-in .dish {
    opacity: 1;
    scale: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .table-art .dish {
      opacity: 1;
      scale: 1;
      transition: none;
    }
  }
</style>
