---
import platterPhoto from '../assets/photos/signature-platter.jpg';
import detailPhoto from '../assets/photos/signature-detail.jpg';
import grilledPhoto from '../assets/photos/signature-grilled.jpg';
import closeupPhoto from '../assets/photos/signature-closeup.jpg';
import { broadcasts, formatPrice, meatMenu, quotes } from '../data/restaurant';
import Photo from './Photo.astro';
import SectionLabel from './SectionLabel.astro';

const signature = meatMenu.find((m) => m.signature)!;
const origin = broadcasts[0];
const dot = (iso: string) => iso.split('-').map((n) => String(Number(n))).join('. ') + '.';

const thumbs = [
  {
    src: detailPhoto,
    alt: '접시 가장자리를 따라 부채꼴로 펼쳐 놓은 오늘뭐먹지? 한우 모둠의 결.',
  },
  {
    src: grilledPhoto,
    alt: '초록 잎채소 위에 올린, 겉면을 노릇하게 구운 한우 한 점.',
  },
  {
    src: closeupPhoto,
    alt: '가운데에 겹겹이 쌓고 둘레에 부채꼴로 두른 오늘뭐먹지? 한우 모둠 근접 사진.',
  },
];
---

<section id="signature" class="surface-ink section-y relative isolate overflow-hidden" aria-labelledby="signature-title">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -right-40 top-10 -z-10 h-[46rem] w-[46rem] rounded-full bg-[radial-gradient(closest-side,color-mix(in_oklab,var(--color-gold-500)_10%,transparent),transparent)]"
  >
  </div>

  <div class="container-site">
    <SectionLabel id="signature" tone="ink" />

    <div class="mt-12 grid gap-y-14 lg:mt-16 lg:grid-cols-12 lg:gap-x-14">
      <div class="lg:col-span-7">
        <Photo
          src={platterPhoto}
          alt="큰 흰 접시에 한우 부채·치마·갈비를 햇살처럼 둥글게 펼쳐 담은 대표 메뉴 오늘뭐먹지?."
          sizes="(min-width: 64rem) 55vw, 100vw"
          class="aspect-[4/3] w-full max-sm:-mx-[var(--gutter)] max-sm:w-[calc(100%+2*var(--gutter))]"
          position="50% 45%"
        />
        <ul class="mt-3 grid grid-cols-3 gap-3 sm:mt-4 sm:gap-4">
          {
            thumbs.map((t, i) => (
              <li>
                <Photo src={t.src} alt={t.alt} sizes="(min-width: 64rem) 18vw, 33vw" class="aspect-square" delay={120 + i * 90} />
              </li>
            ))
          }
        </ul>
      </div>

      <div class="lg:col-span-5 lg:pt-4">
        <p class="flex items-center gap-3 text-[0.8rem] tracking-[0.2em] text-hanji-300" data-reveal>
          <span class="inline-flex h-6 items-center bg-seal-500 px-2.5 text-[0.72rem] font-medium tracking-[0.18em] text-hanji-50">
            대표
          </span>
          내당한우 스페셜 메뉴
        </p>
        <h2 id="signature-title" class="mt-6 font-display text-[clamp(2.75rem,7vw,5.25rem)] font-normal leading-[1.1] tracking-[-0.02em] text-hanji-50" data-reveal="ink">
          {signature.name}
        </h2>
        <p class="mt-6 font-display text-[1.25rem] tracking-[0.18em] text-gold-300 lg:text-[1.4rem]" data-reveal style="--delay:120ms">
          부채 · 치마 · 갈비
        </p>

        <div class="mt-10 border-y border-hanji-100/12 py-6" data-reveal style="--delay:180ms">
          <p class="flex items-baseline text-hanji-100">
            <span class="text-[0.95rem] tracking-[0.08em] text-hanji-300">한우 {signature.weight}</span>
            <span class="leader text-hanji-400" aria-hidden="true"></span>
            <span class="tabular font-display text-[1.9rem] font-medium">{formatPrice(signature.price)}</span>
            <span class="ml-1.5 text-[0.95rem] text-hanji-300">원</span>
          </p>
          <p class="mt-3 text-[0.85rem] text-hanji-400">* {signature.note}</p>
        </div>

        <div class="mt-12" data-reveal style="--delay:240ms">
          <h3 class="font-display text-[1.2rem] font-medium tracking-[0.04em] text-hanji-50">방송에서 시작된 한 접시</h3>
          <p class="mt-4 text-[1rem] leading-[1.95] text-hanji-300">
            {origin.channel} 〈{origin.program}〉 {origin.episode}(<time datetime={origin.date} class="whitespace-nowrap">{dot(origin.date)}</time>) 홍성
            편에서 특수부위로 소개된 뒤, 방송에 나온 특수부위를 한 접시에 모아 만든 모둠입니다.
          </p>
        </div>
      </div>
    </div>

    <div class="mt-24 lg:mt-36">
      <div class="grid gap-y-10 lg:grid-cols-12 lg:gap-x-14">
        <div class="lg:col-span-4">
          <p class="eyebrow text-gold-400" data-reveal>On Air</p>
          <h3 class="mt-6 font-display text-[clamp(1.9rem,4vw,2.75rem)] font-normal leading-[1.3] text-hanji-50" data-reveal="ink">
            방송에 소개된 내당
          </h3>
        </div>

        <ol class="lg:col-span-8">
          {
            broadcasts.map((b, i) => (
              <li
                class="grid grid-cols-[4.25rem_1fr] gap-x-5 border-t border-hanji-100/12 py-6 last:border-b sm:grid-cols-[6.5rem_1fr_auto] sm:items-baseline lg:py-7"
                data-reveal
                style={`--delay:${i * 90}ms`}
              >
                <time datetime={b.date} class="tabular font-display text-[1.5rem] leading-none text-gold-300 sm:text-[1.9rem]">
                  {b.date.slice(0, 4)}
                </time>
                <div>
                  <p class="font-display text-[1.1rem] text-hanji-50 sm:text-[1.2rem]">〈{b.program}〉</p>
                  <p class="mt-1.5 text-[0.85rem] tracking-[0.03em] text-hanji-400">
                    {b.channel} · {b.episode} · <span class="tabular whitespace-nowrap">{dot(b.date)}</span>
                  </p>
                </div>
                <p class="col-start-2 mt-3 text-[0.85rem] tracking-[0.1em] text-hanji-300 sm:col-start-3 sm:mt-0">{b.topic}</p>
              </li>
            ))
          }
        </ol>
      </div>

      <figure class="mx-auto mt-20 max-w-3xl text-center lg:mt-28" data-reveal>
        <span aria-hidden="true" class="font-display text-[3.5rem] leading-none text-gold-500/60">“</span>
        <blockquote class="-mt-3 font-display text-[1.35rem] font-light leading-[1.85] text-hanji-100 lg:text-[1.7rem]">
          {quotes.regulars}
        </blockquote>
        <figcaption class="mt-6 text-[0.8rem] tracking-[0.2em] text-hanji-400">내당한우 인사말 중에서</figcaption>
      </figure>
    </div>
  </div>
</section>
