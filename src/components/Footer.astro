---
import HanjaMark from './HanjaMark.astro';
import Seal from './Seal.astro';

const year = new Date().getFullYear();
---

<footer id="site-footer" class="surface-ink relative overflow-hidden pb-[calc(2.5rem+env(safe-area-inset-bottom))] pt-20 text-hanji-300 lg:pt-28">
  <HanjaMark
    class="pointer-events-none absolute -bottom-[0.14em] right-[-0.04em] select-none text-[clamp(9rem,30vw,26rem)] text-hanji-100/[0.035]"
  />

  <div class="container-site relative">
    <div class="flex items-center gap-4">
      <Seal class="h-14 w-auto" />
      <p class="font-display text-[1.5rem] font-medium tracking-[0.2em] text-hanji-50">내당한우</p>
    </div>

    <div class="mt-20 border-t border-hanji-100/10 pt-8 text-[0.78rem] leading-relaxed text-hanji-500">
      <p>© {year}</p>
    </div>
  </div>
</footer>
