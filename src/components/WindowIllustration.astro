---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;

// Deterministic PRNG so the drawing is identical on every build.
function mulberry32(seed: number) {
  return () => {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rand = mulberry32(1451);

// Geometry (viewBox 600 × 760)
const frame = { x: 22, y: 22, w: 556, h: 704, t: 24 };
const inner = { x: frame.x + frame.t, y: frame.y + frame.t, w: frame.w - frame.t * 2, h: frame.h - frame.t * 2 };
const panelW = 212;
const panel = { x: inner.x, y: inner.y, w: panelW, h: inner.h };
const view = { x: inner.x + panelW, y: inner.y, w: inner.w - panelW, h: inner.h };

// Fortress wall (성벽) with parapet (여장)
const wallTop = 452;
const wallBottom = 626;
const rows: { x: number; y: number; w: number; h: number; o: number }[] = [];
let y = wallTop;
while (y < wallBottom) {
  const h = 20 + rand() * 9;
  let x = view.x - 30 * rand();
  while (x < view.x + view.w) {
    const w = 30 + rand() * 38;
    rows.push({ x, y, w: w - 3, h: Math.min(h, wallBottom - y) - 3, o: 0.1 + rand() * 0.2 });
    x += w;
  }
  y += h;
}
const merlons: { x: number; w: number }[] = [];
for (let x = view.x - 8; x < view.x + view.w; x += 62) merlons.push({ x, w: 50 });

// Latticework (띠살): vertical bars plus three bands of horizontal bars
const bars = Array.from({ length: 11 }, (_, i) => panel.x + 12 + i * ((panel.w - 24) / 10));
const bands = [panel.y + 38, panel.y + panel.h / 2 - 24, panel.y + panel.h - 88].flatMap((b) =>
  [0, 11, 22, 33].map((d) => b + d),
);

// Pine needle clusters
const clusters = [
  { x: 548, y: 118, r: 40 },
  { x: 500, y: 150, r: 34 },
  { x: 452, y: 196, r: 30 },
  { x: 404, y: 226, r: 26 },
  { x: 520, y: 214, r: 28 },
  { x: 470, y: 258, r: 22 },
  { x: 560, y: 60, r: 30 },
];
---

<svg
  class={className}
  viewBox="0 0 600 760"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-labelledby="window-art-title"
>
  <title id="window-art-title">한지를 바른 띠살 창 한쪽이 열려 있고, 그 너머로 소나무 가지와 홍주읍성 성벽이 보이는 모습을 그린 수묵 일러스트</title>
  <defs>
    <clipPath id="view-clip">
      <rect x={view.x} y={view.y} width={view.w} height={view.h}></rect>
    </clipPath>
    <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#e9dfcc"></stop>
      <stop offset="0.55" stop-color="#f3ecdf"></stop>
      <stop offset="1" stop-color="#efe6d6"></stop>
    </linearGradient>
    <radialGradient id="paper-glow" cx="0.45" cy="0.42" r="0.75">
      <stop offset="0" stop-color="#fff6e2"></stop>
      <stop offset="0.6" stop-color="#f6e8cc"></stop>
      <stop offset="1" stop-color="#e8d6b4"></stop>
    </radialGradient>
    <filter id="wash" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="6"></feGaussianBlur>
    </filter>
    <filter id="ink-edge" x="-10%" y="-10%" width="120%" height="120%">
      <feTurbulence type="fractalNoise" baseFrequency="0.06" numOctaves="2" seed="8" result="n"></feTurbulence>
      <feDisplacementMap in="SourceGraphic" in2="n" scale="5" xChannelSelector="R" yChannelSelector="G"></feDisplacementMap>
    </filter>
    <filter id="needles" x="-30%" y="-30%" width="160%" height="160%">
      <feTurbulence type="fractalNoise" baseFrequency="0.09" numOctaves="3" seed="21" result="n"></feTurbulence>
      <feDisplacementMap in="SourceGraphic" in2="n" scale="16" xChannelSelector="R" yChannelSelector="G" result="d"></feDisplacementMap>
      <feGaussianBlur in="d" stdDeviation="0.6"></feGaussianBlur>
    </filter>
    <pattern id="paper-fiber" width="80" height="80" patternUnits="userSpaceOnUse">
      <path d="M4 12c14 3 22-2 34 4M46 30c10-4 20 2 30-1M8 52c12 2 18-3 30 1M40 70c12 3 24-2 36 2" fill="none" stroke="#c9b48e" stroke-width="0.5" opacity="0.45"></path>
    </pattern>
  </defs>

  <!-- View beyond the window -->
  <g clip-path="url(#view-clip)">
    <rect x={view.x} y={view.y} width={view.w} height={view.h} fill="url(#sky)"></rect>
    <circle cx="470" cy="186" r="30" fill="#d8bf8c" opacity="0.32"></circle>

    <g filter="url(#wash)">
      <path d="M220 400 C 290 330 340 350 390 316 C 440 282 500 320 600 300 L 600 470 L 220 470 Z" fill="#141311" opacity="0.07"></path>
      <path d="M220 440 C 300 392 360 410 420 380 C 470 356 540 392 600 372 L 600 480 L 220 480 Z" fill="#141311" opacity="0.1"></path>
    </g>

    <!-- parapet -->
    <g filter="url(#ink-edge)">
      {
        merlons.map((m) => (
          <g>
            <rect x={m.x} y={wallTop - 34} width={m.w} height="34" fill="#2d2a26" opacity="0.22"></rect>
            <rect x={m.x + m.w / 2 - 3} y={wallTop - 22} width="6" height="10" fill="#f3ecdf" opacity="0.9"></rect>
          </g>
        ))
      }
      <rect x={view.x} y={wallTop - 4} width={view.w} height="6" fill="#2d2a26" opacity="0.28"></rect>
      {rows.map((s) => <rect x={s.x} y={s.y} width={s.w} height={s.h} rx="3" fill="#2d2a26" opacity={s.o.toFixed(2)}></rect>)}
    </g>

    <!-- ground -->
    <rect x={view.x} y={wallBottom} width={view.w} height={view.h - (wallBottom - view.y)} fill="#e7dcc8"></rect>
    <path d="M250 640 q 6 -14 10 0 M300 652 q 4 -12 8 0 M420 646 q 5 -13 9 0 M500 660 q 4 -10 8 0" stroke="#5f5952" stroke-width="1.2" fill="none" opacity="0.5"></path>

    <!-- pine branch -->
    <g filter="url(#ink-edge)">
      <path d="M612 40 C 560 70 540 110 500 150 C 470 180 440 200 396 228" stroke="#1a1816" stroke-width="7" fill="none" stroke-linecap="round"></path>
      <path d="M540 116 C 530 160 520 190 510 214" stroke="#1a1816" stroke-width="4" fill="none" stroke-linecap="round"></path>
      <path d="M470 180 C 470 214 468 236 464 256" stroke="#1a1816" stroke-width="3" fill="none" stroke-linecap="round"></path>
    </g>
    <g filter="url(#needles)">
      {clusters.map((c) => <ellipse cx={c.x} cy={c.y} rx={c.r * 1.25} ry={c.r * 0.62} fill="#1a1816" opacity="0.82"></ellipse>)}
    </g>
  </g>

  <!-- Closed sliding panel: lattice over lit hanji -->
  <rect x={panel.x} y={panel.y} width={panel.w} height={panel.h} fill="url(#paper-glow)"></rect>
  <rect x={panel.x} y={panel.y} width={panel.w} height={panel.h} fill="url(#paper-fiber)"></rect>
  <g fill="#2d2a26">
    {bars.map((x) => <rect x={x - 1.2} y={panel.y} width="2.4" height={panel.h}></rect>)}
    {bands.map((by) => <rect x={panel.x} y={by} width={panel.w} height="2.4"></rect>)}
  </g>
  <rect x={panel.x + 4} y={panel.y} width={panel.w - 8} height={panel.h} fill="none" stroke="#211f1c" stroke-width="10"></rect>
  <rect x={panel.x + panel.w - 6} y={panel.y} width="8" height={panel.h} fill="#141311" opacity="0.35"></rect>

  <!-- Window frame -->
  <path
    fill-rule="evenodd"
    fill="#211f1c"
    d={`M${frame.x} ${frame.y}h${frame.w}v${frame.h}h-${frame.w}z M${inner.x} ${inner.y}v${inner.h}h${inner.w}v-${inner.h}z`}
  ></path>
  <rect x={frame.x - 10} y={frame.y + frame.h - 4} width={frame.w + 20} height="18" fill="#141311"></rect>
  <rect x={frame.x} y={frame.y} width={frame.w} height={frame.h} fill="none" stroke="#3d3934" stroke-width="1"></rect>
</svg>
