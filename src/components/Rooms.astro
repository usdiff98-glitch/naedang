---
import { quotes } from '../data/restaurant';
import SectionLabel from './SectionLabel.astro';
import WindowIllustration from './WindowIllustration.astro';

const details = [
  {
    title: '본관과 별관',
    body: '오래된 건물을 깔끔하게 고쳐, 본관과 별관에 크기가 다른 룸을 두었습니다.',
  },
  {
    title: '소나무와 연못',
    body: '소나무와 작은 정원, 잉어가 노니는 연못, 자갈로 쌓은 우물 조형물이 마당을 채웁니다.',
  },
  {
    title: '창 너머 성벽',
    body: '별관 끝방에서는 창살 너머로 홍주읍성 성벽이 보입니다.',
  },
  {
    title: '은은한 조명',
    body: '모든 좌석이 룸이라, 은은한 조명 아래 조용히 이야기 나누기 좋습니다.',
  },
];

const occasions = ['가족 모임', '접대', '기념일', '단체 모임'];
---

<section id="rooms" class="surface-hanji section-y relative overflow-hidden" aria-labelledby="rooms-title">
  <div class="container-site grid gap-y-16 lg:grid-cols-12 lg:items-center lg:gap-x-16">
    <figure class="relative lg:col-span-5" data-reveal>
      <WindowIllustration class="h-auto w-full drop-shadow-[0_30px_40px_rgba(20,19,17,0.18)]" />
      <figcaption class="mt-5 flex items-center gap-3 text-[0.8rem] tracking-[0.06em] text-ink-500">
        <span class="h-px w-8 bg-gold-600/70"></span>
        별관 끝방, 창살 너머 홍주읍성 — 그림
      </figcaption>
    </figure>

    <div class="lg:col-span-7 lg:pl-4">
      <SectionLabel id="rooms" />
      <h2 id="rooms-title" class="mt-8 font-display text-[clamp(2.4rem,6vw,4.4rem)] font-normal leading-[1.2] tracking-[-0.02em]" data-reveal="ink">
        모든 자리는<br />방입니다.
      </h2>
      <p class="mt-8 max-w-xl font-display text-[1.15rem] leading-[1.9] text-ink-800 lg:text-[1.3rem]" data-reveal style="--delay:120ms">
        작은 방부터 단체 모임을 위한 큰 방까지, 한옥 콘셉트로 꾸민 모든 좌석이 룸으로 되어 있습니다.
      </p>

      <dl class="mt-12 grid gap-x-10 sm:grid-cols-2">
        {
          details.map((d, i) => (
            <div class="border-t border-ink-900/12 py-6" data-reveal style={`--delay:${i * 90}ms`}>
              <dt class="font-display text-[1.15rem] font-medium tracking-[0.04em]">{d.title}</dt>
              <dd class="mt-2 text-[0.95rem] leading-[1.85] text-ink-500">{d.body}</dd>
            </div>
          ))
        }
      </dl>

      <div class="mt-6 flex flex-col gap-6 border-t border-ink-900/12 pt-8 sm:flex-row sm:items-center sm:justify-between" data-reveal>
        <p class="font-display text-[1.05rem] text-ink-800">
          “{quotes.rooms}”
          <span class="mt-1 block font-sans text-[0.75rem] tracking-[0.12em] text-ink-500">내당한우 소개글 중에서</span>
        </p>
        <ul class="flex flex-wrap gap-2" aria-label="이런 자리에 좋습니다">
          {
            occasions.map((o) => (
              <li class="border border-ink-900/15 px-3 py-1.5 text-[0.8rem] tracking-[0.08em] text-ink-700">{o}</li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
