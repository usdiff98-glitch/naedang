---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Seal from '../components/Seal.astro';
import { info } from '../data/restaurant';
import { withBase } from '../lib/urls';
---

<BaseLayout title="페이지를 찾을 수 없습니다 | 내당한우 內堂" description="요청하신 페이지를 찾을 수 없습니다." path="/404" noindex>
  <main class="surface-ink grid min-h-[100svh] place-items-center px-[var(--gutter)] py-20 text-center">
    <div class="max-w-md">
      <Seal class="mx-auto h-24 w-auto" />
      <p class="mt-10 text-[0.75rem] tracking-[0.3em] text-gold-400">404</p>
      <h1 class="mt-4 font-display text-[1.9rem] font-normal leading-snug text-hanji-50">찾으시는 페이지가 없어요</h1>
      <p class="mt-4 text-[0.95rem] leading-relaxed text-hanji-300">주소가 바뀌었거나 없어진 페이지예요.</p>
      <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:justify-center">
        <a href={withBase('/')} class="btn btn-gold">처음으로</a>
        <a href={info.phoneHref} class="btn btn-line-light tabular">
          <Icon name="phone" />
          {info.phone}
        </a>
      </div>
    </div>
  </main>
</BaseLayout>
