---
import BaseLayout from '../layouts/BaseLayout.astro';
import Butcher from '../components/Butcher.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import MenuSection from '../components/MenuSection.astro';
import Rooms from '../components/Rooms.astro';
import Signature from '../components/Signature.astro';
import Story from '../components/Story.astro';
import TableSetting from '../components/TableSetting.astro';
import Visit from '../components/Visit.astro';

const title = '내당한우 內堂 | 홍성 홍주읍성 맞은편 한우집';
const description =
  '홍성 홍주읍성 맞은편 한우집입니다. 고기는 한우만 쓰고, 자리는 모두 방이에요. 길가 정육점도 같이 해요. 대표 메뉴 오늘뭐먹지?(부채·치마·갈비 150g) 45,000원. 매일 11:00~22:00, 브레이크타임 15:00~17:00. 예약 041-632-0156';
---

<BaseLayout title={title} description={description} structuredData>
  <Header />
  <main id="main">
    <Hero />
    <Story />
    <Signature />
    <MenuSection />
    <TableSetting />
    <Rooms />
    <Butcher />
    <Visit />
  </main>
  <Footer />
</BaseLayout>

<script>
  import '../scripts/site.ts';
</script>
