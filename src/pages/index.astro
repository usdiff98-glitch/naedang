---
import BaseLayout from '../layouts/BaseLayout.astro';
import Butcher from '../components/Butcher.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import MenuSection from '../components/MenuSection.astro';
import Rooms from '../components/Rooms.astro';
import Signature from '../components/Signature.astro';
import Story from '../components/Story.astro';
import TableSetting from '../components/TableSetting.astro';
import Visit from '../components/Visit.astro';

const title = '내당한우 內堂 | 홍성 한우생고기 전문점 · 홍주읍성 맞은편';
const description =
  '홍성 홍주읍성 맞은편에 있는 한우집 내당한우입니다. 입구에 정육점이 있고, 자리는 모두 방입니다. 대표 메뉴는 오늘뭐먹지?(부채·치마·갈비 150g 45,000원). 매일 11시~22시, 브레이크타임 15시~17시. 예약 041-632-0156';
---

<BaseLayout title={title} description={description} structuredData>
  <Header />
  <main id="main">
    <Hero />
    <Story />
    <Signature />
    <MenuSection />
    <TableSetting />
    <Rooms />
    <Butcher />
    <Visit />
  </main>
  <Footer />
</BaseLayout>

<script>
  import '../scripts/site.ts';
</script>
