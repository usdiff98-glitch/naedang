---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import MenuSection from '../components/MenuSection.astro';
import Signature from '../components/Signature.astro';
import Visit from '../components/Visit.astro';

const title = '내당한우 內堂 | 홍성 홍주읍성 맞은편 한우집';
const description =
  '홍성 홍주읍성 맞은편 한우집. 매일 11:00~22:00, 브레이크타임 15:00~17:00, 설날·추석 연휴 3일 휴무. 충남 홍성군 홍성읍 아문길52번길 6. 예약 041-632-0156';
---

<BaseLayout title={title} description={description} structuredData>
  <Header />
  <main id="main">
    <Hero />
    <MenuSection />
    <Signature />
    <Visit />
  </main>
  <Footer />
</BaseLayout>

<script>
  import '../scripts/site.ts';
</script>
